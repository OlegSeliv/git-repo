//@version=6
indicator("LogReg RSI Combo", "LogReg RSI Combo", overlay = true)

// ?????? ????????????????????????????????????????????????????????????????????????????????????????????????????????{
int   length             = input.int(100, "LogReg Lookback")
float channel_width      = input.float(1.5, "Channel Width", step = 0.1)
int   channel_len        = input(100, "Channel Length")
int   rsi_length         = input.int(14, "RSI Length")
float proximity_mult     = input.float(0.5, "Proximity (? multiplier)", step = 0.1, minval = 0.0)
bool  require_trend_agree= input.bool(true, "Filter: LogReg Trend Agreement")
bool  mid_disp           = input.bool(true, "Mid Line", inline = "s")
bool  fill_band          = input.bool(true, "Fill Band", inline = "s")
color col1               = input.color(#21dfac, "", inline = "s1")
color col2               = input.color(#df216d, "", inline = "s1")
// }


// ??????????????????????????????????????????????????????????????????????????????????????????????????????????{
f_log_regression(src, length) =>
    float sumX    = 0.0
    float sumY    = 0.0
    float sumXSqr = 0.0
    float sumXY   = 0.0

    for i = 0 to length - 1
        val = math.log(src[i])
        per = i + 1.0
        sumX    += per
        sumY    += val
        sumXSqr += per * per
        sumXY   += val * per

    slope     = (length * sumXY - sumX * sumY) / (length * sumXSqr - sumX * sumX)
    average   = sumY / length
    intercept = average - slope * sumX / length + slope

    [slope, intercept]

[slope, intercept] = f_log_regression(close, length)

float start        = math.exp(intercept + slope * length)
float end          = math.exp(intercept)
float diff         = end - end[3]
float deviation    = ta.stdev(close, length)

float upper_inner  = end + deviation * channel_width
float lower_inner  = end - deviation * channel_width
float upper_outer  = end + deviation * (channel_width + 0.3)
float lower_outer  = end - deviation * (channel_width + 0.3)

float proximity    = deviation * proximity_mult

bool price_near_lower = close <= lower_inner + proximity and close >= lower_outer - proximity
bool price_near_upper = close >= upper_inner - proximity and close <= upper_outer + proximity

float rsi = ta.rsi(close, rsi_length)
bool  rsi_cross_up   = ta.crossover(rsi, 50)
bool  rsi_cross_down = ta.crossunder(rsi, 50)

bool long_trend_ok  = diff > 0
bool short_trend_ok = diff < 0

bool long_signal_raw  = barstate.isconfirmed and rsi_cross_up   and price_near_lower
bool short_signal_raw = barstate.isconfirmed and rsi_cross_down and price_near_upper

bool long_signal  = long_signal_raw  and (not require_trend_agree or long_trend_ok)
bool short_signal = short_signal_raw and (not require_trend_agree or short_trend_ok)
// }


// ???? ????????????????????????????????????????????????????????????????????????????????????????????????????????????{
color color_up    = color.from_gradient(diff, ta.lowest(diff, 200), ta.highest(diff, 200), na, col1)
color color_dn    = color.from_gradient(diff, ta.lowest(diff, 200), ta.highest(diff, 200), col2, na)
color channel_col = end > end[1] ? col1 : col2
color trend_col   = end > end[3] ? color_up : color_dn
color trend_col1  = end > end[3] ? col1 : col2

p1 = plot(end, "Log Regression", color = trend_col1, linewidth = 2)
p2 = plot(end[3], color = trend_col, display = display.none, editable = false)

fill(p1, p2, fill_band ? trend_col : na)

plotshape(long_signal ? close : na,  title = "Long Dot",  location = location.absolute, style = shape.circle, color = col1, size = size.large)
plotshape(short_signal ? close : na, title = "Short Dot", location = location.absolute, style = shape.circle, color = col2, size = size.large)

// Define channel lines
upper_outer_plot = plot(upper_outer, "Upper Outer", color = color.new(channel_col, 0), linewidth = 2)
upper_inner_plot = plot(upper_inner, "Upper Inner", color = color.new(channel_col, 60), linewidth = 1)
lower_inner_plot = plot(lower_inner, "Lower Inner", color = color.new(channel_col, 60), linewidth = 1)
lower_outer_plot = plot(lower_outer, "Lower Outer", color = color.new(channel_col, 0), linewidth = 2)

mid_plot = plot(mid_disp ? end : na, "Mid", color = color.new(chart.fg_color, 20), linewidth = 1, style = plot.style_dashed)

fill(upper_outer_plot, upper_inner_plot, color.new(channel_col, 75))
fill(lower_inner_plot, lower_outer_plot, color.new(channel_col, 75))

// Alerts
alertcondition(long_signal,  title = "LogReg RSI Long",  message = "LogReg RSI Combo: Long signal")
alertcondition(short_signal, title = "LogReg RSI Short", message = "LogReg RSI Combo: Short signal")

// Info Dash
if barstate.islast
    dash = table.new(position.top_right, 10, 10, bgcolor = color.new(chart.fg_color, 90), border_color = chart.bg_color, border_width = 5)
    dash.cell(0, 0, "Slope: " + str.tostring(slope * 100, "#,###.###"), text_color = chart.fg_color)
    dash.cell(0, 1, "Channel: " + (end > end[1] ? "UP" : "DN"), text_color = channel_col)
    dash.cell(0, 2, "RSI: " + str.tostring(rsi, "#,##0.0"), text_color = rsi >= 50 ? col1 : col2)
    dash.cell(0, 3, "Trend Filter: " + (require_trend_agree ? (diff > 0 ? "Long Bias" : diff < 0 ? "Short Bias" : "Flat") : "OFF"), text_color = chart.fg_color)
// }
