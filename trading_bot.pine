//@version=5
strategy("RSI + StochRSI Trading Bot", shorttitle="RSI+StochRSI Bot", overlay=false, default_qty_type=strategy.percent_of_equity, default_qty_value=10)

// === ВХОДНЫЕ ПАРАМЕТРЫ ===
// RSI параметры
rsi_length = input.int(14, title="RSI Length", minval=1)
rsi_4h_threshold = input.int(50, title="RSI 4H Threshold", minval=0, maxval=100)

// StochRSI параметры
stochrsi_length_rsi = input.int(8, title="StochRSI RSI Length", minval=1)
stochrsi_length_stoch = input.int(5, title="StochRSI Stoch Length", minval=1)
stochrsi_smooth_k = input.int(3, title="StochRSI Smooth K", minval=1)
stochrsi_smooth_d = input.int(3, title="StochRSI Smooth D", minval=1)

// Уровни StochRSI
stochrsi_oversold = input.int(25, title="StochRSI Oversold", minval=0, maxval=100)
stochrsi_overbought = input.int(75, title="StochRSI Overbought", minval=0, maxval=100)
stochrsi_long_exit = input.int(80, title="StochRSI Long Exit", minval=0, maxval=100)
stochrsi_short_exit = input.int(20, title="StochRSI Short Exit", minval=0, maxval=100)

// Дивергенция
divergence_length = input.int(5, title="Divergence Lookback", minval=1)

// === ФУНКЦИИ ===
// Функция для расчета StochRSI
f_stochrsi(src, rsi_length, stoch_length, smooth_k, smooth_d) =>
    rsi_val = ta.rsi(src, rsi_length)
    stoch_val = ta.stoch(rsi_val, rsi_val, rsi_val, stoch_length)
    k = ta.sma(stoch_val, smooth_k)
    d = ta.sma(k, smooth_d)
    [k, d]

// Функция для проверки дивергенции
f_check_divergence(price_series, indicator_series, length) =>
    var float bull_div = na
    var float bear_div = na
    
    // Поиск локальных максимумов и минимумов
    price_high = ta.highest(price_series, length)
    price_low = ta.lowest(price_series, length)
    ind_high = ta.highest(indicator_series, length)
    ind_low = ta.lowest(indicator_series, length)
    
    // Бычья дивергенция (цена делает новый минимум, RSI - нет)
    if price_series == price_low and indicator_series > ind_low
        bull_div := price_series
    else
        bull_div := na
    
    // Медвежья дивергенция (цена делает новый максимум, RSI - нет)
    if price_series == price_high and indicator_series < ind_high
        bear_div := price_series
    else
        bear_div := na
    
    [bull_div, bear_div]

// === ОСНОВНЫЕ РАСЧЕТЫ ===
// RSI на 4-часовом таймфрейме
rsi_4h = request.security(syminfo.tickerid, "240", ta.rsi(close, rsi_length))

// StochRSI на 15-минутном таймфрейме
[stochrsi_k, stochrsi_d] = request.security(syminfo.tickerid, "15", f_stochrsi(close, stochrsi_length_rsi, stochrsi_length_stoch, stochrsi_smooth_k, stochrsi_smooth_d))

// Дивергенция RSI
[price_bull_div, price_bear_div] = f_check_divergence(close, rsi_4h, divergence_length)

// === ЛОГИКА СИГНАЛОВ ===
// Условия для входа в лонг
rsi_bullish = rsi_4h > rsi_4h_threshold
stochrsi_long_entry = ta.crossover(stochrsi_k, stochrsi_oversold)
long_entry = rsi_bullish and stochrsi_long_entry

// Условия для входа в шорт
rsi_bearish = rsi_4h < rsi_4h_threshold
stochrsi_short_entry = ta.crossunder(stochrsi_k, stochrsi_overbought)
short_entry = rsi_bearish and stochrsi_short_entry

// Условия для выхода
long_exit = ta.crossunder(stochrsi_k, stochrsi_long_exit)
short_exit = ta.crossover(stochrsi_k, stochrsi_short_exit)

// Бонусные условия (дивергенция)
long_with_divergence = long_entry and not na(price_bull_div)
short_with_divergence = short_entry and not na(price_bear_div)

// === ТОРГОВАЯ ЛОГИКА ===
if long_entry and strategy.position_size == 0
    strategy.entry("Long", strategy.long, comment="Long Entry")
    
if short_entry and strategy.position_size == 0
    strategy.entry("Short", strategy.short, comment="Short Entry")

if long_exit and strategy.position_size > 0
    strategy.close("Long", comment="Long Exit")
    
if short_exit and strategy.position_size < 0
    strategy.close("Short", comment="Short Exit")

// === ВИЗУАЛИЗАЦИЯ ===
// Уровни StochRSI
hline(stochrsi_oversold, "Oversold", color=color.blue, linestyle=hline.style_dashed)
hline(stochrsi_overbought, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(stochrsi_long_exit, "Long Exit", color=color.green, linestyle=hline.style_dotted)
hline(stochrsi_short_exit, "Short Exit", color=color.orange, linestyle=hline.style_dotted)

// График StochRSI
plot(stochrsi_k, "StochRSI K", color=color.black, linewidth=2)
plot(stochrsi_d, "StochRSI D", color=color.fuchsia, linewidth=1)

// RSI 4H в отдельном окне
rsi_4h_plot = plot(rsi_4h, "RSI 4H", color=color.purple, linewidth=2)
hline(rsi_4h_threshold, "RSI 4H Threshold", color=color.gray, linestyle=hline.style_solid)

// Сигналы входа
plotshape(long_entry, "Long Entry", shape.triangleup, location.belowbar, color=color.green, size=size.small)
plotshape(short_entry, "Short Entry", shape.triangledown, location.abovebar, color=color.red, size=size.small)

// Сигналы с дивергенцией
plotshape(long_with_divergence, "Long + Divergence", shape.triangleup, location.belowbar, color=color.lime, size=size.normal)
plotshape(short_with_divergence, "Short + Divergence", shape.triangledown, location.abovebar, color=color.maroon, size=size.normal)

// Сигналы выхода
plotshape(long_exit, "Long Exit", shape.xcross, location.abovebar, color=color.blue, size=size.small)
plotshape(short_exit, "Short Exit", shape.xcross, location.belowbar, color=color.orange, size=size.small)

// Дивергенция
plotshape(price_bull_div, "Bull Divergence", shape.diamond, location.belowbar, color=color.yellow, size=size.tiny)
plotshape(price_bear_div, "Bear Divergence", shape.diamond, location.abovebar, color=color.yellow, size=size.tiny)

// === АЛЕРТЫ ===
alertcondition(long_entry, "Long Entry Signal", "StochRSI crossed above {{plot(\"Oversold\")}} with RSI 4H > 50")
alertcondition(short_entry, "Short Entry Signal", "StochRSI crossed below {{plot(\"Overbought\")}} with RSI 4H < 50")
alertcondition(long_exit, "Long Exit Signal", "StochRSI crossed below {{plot(\"Long Exit\")}}")
alertcondition(short_exit, "Short Exit Signal", "StochRSI crossed above {{plot(\"Short Exit\")}}")
alertcondition(long_with_divergence, "Long + Divergence", "Long entry with bullish divergence detected")
alertcondition(short_with_divergence, "Short + Divergence", "Short entry with bearish divergence detected")

// === ТАБЛИЦА С ИНФОРМАЦИЕЙ ===
if barstate.islast
    var table info_table = table.new(position.top_right, 2, 6, bgcolor=color.white, border_width=1)
    table.cell(info_table, 0, 0, "RSI 4H", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 0, str.tostring(math.round(rsi_4h, 2)), text_color=color.black)
    table.cell(info_table, 0, 1, "StochRSI K", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 1, str.tostring(math.round(stochrsi_k, 2)), text_color=color.black)
    table.cell(info_table, 0, 2, "StochRSI D", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 2, str.tostring(math.round(stochrsi_d, 2)), text_color=color.black)
    table.cell(info_table, 0, 3, "Position", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 3, strategy.position_size > 0 ? "LONG" : strategy.position_size < 0 ? "SHORT" : "FLAT", 
               text_color=strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.black)
    table.cell(info_table, 0, 4, "Bull Div", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 4, not na(price_bull_div) ? "YES" : "NO", 
               text_color=not na(price_bull_div) ? color.green : color.black)
    table.cell(info_table, 0, 5, "Bear Div", text_color=color.black, bgcolor=color.gray)
    table.cell(info_table, 1, 5, not na(price_bear_div) ? "YES" : "NO", 
               text_color=not na(price_bear_div) ? color.red : color.black)